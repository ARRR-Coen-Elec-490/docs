{
    "editor.wordWrap": "on",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.markdownlint": "explicit"
    },
    "markdown.extension.list.indentationSize": "inherit",
    "editor.tabSize": 4
}
